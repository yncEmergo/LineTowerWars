[resource]
script = ExtResource("1_StampedeTargetAbility")
ability_id = 318
display_name = "Stampede Target"
description = "Link this Beastmaster to one of your own towers. Its beast then always runs towards that tower instead of towards whatever the attack landed on. Only the DIRECTION is taken, so distance does not matter and there is no range on the link. Aim it at this tower to clear the link."
