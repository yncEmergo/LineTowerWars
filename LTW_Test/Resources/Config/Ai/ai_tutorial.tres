[resource]
script = ExtResource("1_ai_profile")
display_name = "Sparring Partner"
description = "What both tutorial opponents play until a lesson wakes them. Builds a short maze for creeps to walk through and sends nothing. Its maze has the same rows and corridors as the profiles they wake into, so the short maze is the top of the long one."
