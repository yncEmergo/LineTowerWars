[resource]
script = ExtResource("1_ai_profile")
display_name = "Tutorial Rookie"
description = "The tutorial's first real opponent, woken once the basics are taught. Slower and simpler than Easy: a short left-right maze it never upgrades, tier 1 sends on a slow beat, no technology. Loaded by path from the tutorial script, never offered in a menu."
