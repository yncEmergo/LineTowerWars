[ext_resource type="Script" path="res://Scripts/Game/Tutorial/TutorialMoment.gd" id="4_moment"]

[sub_resource type="Resource" id="Moment_leak"]
script = ExtResource("4_moment")
trigger = 0
title = "Life stealing"
body = "These creeps are past the Rookie's towers. Each one that reaches the end steals one of the Rookie's lives for you."
incoming_body = "These creeps are past your towers. Each one that reaches the end steals one of your lives and gives it to your opponent."
leak_row = 20

[sub_resource type="Resource" id="Moment_flyer"]
script = ExtResource("4_moment")
trigger = 1
title = "Flyers"
body = "Flyers ignore the maze and fly straight down the lane. Only towers that hit air can shoot them."
delay_seconds = 2.0

[sub_resource type="Resource" id="Moment_attacker"]
script = ExtResource("4_moment")
trigger = 2
title = "Attackers"
body = "Attackers fight the towers in their way. Select them to give them orders, like your builder."
incoming_body = "Attackers fight the towers in their way. These are chewing through your maze, and your towers have to kill them before they open a path."
delay_seconds = 2.0

[resource]
script = ExtResource("1_script")
opponent_gold = 400
first_rival_profile_path = "res://Resources/Config/Ai/ai_tutorial_rookie.tres"
second_rival_profile_path = "res://Resources/Config/Ai/ai_tutorial_veteran.tres"
second_rival_opening_path = "res://Resources/Config/Ai/ai_tutorial_veteran_sparring.tres"
second_rival_gold = 90000
rival_lives = 10
rival_income_share = 1.0
player_lives = 30
always_allowed = Array[ExtResource("3_ability")]([ExtResource("a0_always"), ExtResource("a1_always"), ExtResource("a2_always")])
moments = Array[ExtResource("4_moment")]([SubResource("Moment_leak"), SubResource("Moment_flyer"), SubResource("Moment_attacker")])
forbidden_abilities = Array[ExtResource("3_ability")]([ExtResource("f0_forbidden"), ExtResource("f1_forbidden"), ExtResource("f2_forbidden"), ExtResource("f3_forbidden")])
steps = Array[ExtResource("2_step")]([ExtResource("s0_01_builder"), ExtResource("s1_02_move"), ExtResource("s2_03_first_towers"), ExtResource("s3_04_first_waves"), ExtResource("s4_05_row_cutters"), ExtResource("s5_06_row_archers"), ExtResource("s6_07_upgrade_archers"), ExtResource("s7_08_cannons"), ExtResource("s8_09_skeleton_wave"), ExtResource("s9_10_send_sheep"), ExtResource("s10_11_income_explained"), ExtResource("s11_12_payout"), ExtResource("s12_13_beat_rookie"), ExtResource("s13_14_elemental_core"), ExtResource("s14_15_open_research"), ExtResource("s15_16_research_fire"), ExtResource("s16_17_fire_pit"), ExtResource("s17_18_magma_well"), ExtResource("s18_19_research_firelord"), ExtResource("s19_20_lesser_firelord"), ExtResource("s20_21_greater_firelord"), ExtResource("s21_22_research_lightning"), ExtResource("s22_23_research_glyph"), ExtResource("s23_24_ultimate_firelord"), ExtResource("s24_25_second_core"), ExtResource("s25_26_shock_particle"), ExtResource("s26_27_power_generator"), ExtResource("s27_28_lesser_glyph"), ExtResource("s28_29_greater_glyph"), ExtResource("s29_30_beat_veteran")])
