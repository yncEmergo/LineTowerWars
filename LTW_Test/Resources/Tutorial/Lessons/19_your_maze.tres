[resource]
script = ExtResource("1_step")
continues_lesson = true
body = "Take the Fire Pit up its Firelord branch to the Ultimate, and raise an Annihilation Glyph to Greater. Rebuild your maze as you like: sell what you want, but only elemental towers can be built now."
objective = "Own an Ultimate Firelord and a Greater Annihilation Glyph"
delay_seconds = 0.8
holds_clock = true
grant_gold = 69800
forbids = Array[ExtResource("2_ability")]([ExtResource("f0"), ExtResource("f1"), ExtResource("f2"), ExtResource("f3")])
tower_paths = Array[String](["res://Resources/UnitStats/Towers/fire_ultimate_firelord_stats.tres", "res://Resources/UnitStats/Towers/lightning_greater_annihilation_glyph_stats.tres"])
