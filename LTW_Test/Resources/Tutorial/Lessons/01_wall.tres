[resource]
script = ExtResource("1_step")
title = "Build a wall"
body = "Other players send creeps down your lane. Every one that reaches the bottom steals a life from you.\n\nTowers shoot them - and block their way."
objective = "Build a Lesser Sentry on each blue square."
holds_clock = true
skip_after_seconds = 150.0
grant_gold = 70
blueprint_path = "res://Resources/Tutorial/tutorial_maze_row_1.tres"
restricts_actions = true
allowed_abilities = Array[ExtResource("2_ability")]([ExtResource("3_allowed")])
build_on_blueprint_only = true
highlight_key = &"unit_panel"
selects = 1
