script = ExtResource("1_step")
title = "That is the game"
body = "Build a maze that makes the walk long. Upgrade it rather than rebuilding it. Send early, because income compounds. Research towards one Ultimate and get there. Fill the holes with discs.\n\nEverything else is detail, and you will learn it faster by playing. Try a single player match against an Easy opponent next."
