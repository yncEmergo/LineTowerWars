[ext_resource type="Script" path="res://Scripts/Game/Tutorial/Steps/TutorialIncomeStep.gd" id="1_step"]

[resource]
script = ExtResource("1_step")
title = "Income"
body = "Everyone is paid their income on the same beat. Sending is how you raise yours, and it decides most matches."
