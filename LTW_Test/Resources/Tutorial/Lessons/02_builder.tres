[resource]
script = ExtResource("1_step")
title = "Your builder"
body = "The one unit you control is the builder. It places every tower in the game and it cannot be killed.\n\nSelect it and its command card appears at the bottom of the screen. Building is a physical thing: the builder has to walk to the spot before the tower goes up, and it is free again the moment it starts."
objective = ""
pauses_world = true
skip_after_seconds = 8.0
grant_gold = 0
grant_income = 0
