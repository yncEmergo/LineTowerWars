[ext_resource type="Script" path="res://Scripts/Game/Tutorial/Steps/TutorialResearchStep.gd" id="1_step"]

[resource]
script = ExtResource("1_step")
title = "Technology"
body = "The Veteran joins in, and it is stronger. Basic towers will not hold it for long.\n\nYour first four technologies are free - exactly one Ultimate tower."
objective = "Open the Research Center and research four technologies."
progress_label = "Technologies researched"
delay_seconds = 3.0
wakes_rival = 2
unlocks_research = true
highlight_key = &"research_button"
technologies = 4
