[resource]
script = ExtResource("1_step")
title = "Build a maze"
body = "The creeps simply walked around your towers. Build rows across the lane, each with its gap at the other end - then they have to walk back and forth past every tower."
objective = "Finish the first row with Lesser Sentries."
progress_label = "Towers built"
delay_seconds = 2.0
holds_clock = true
skip_after_seconds = 150.0
grant_gold = 30
blueprint_path = "res://Resources/Tutorial/tutorial_maze_row_1.tres"
restricts_actions = true
allowed_abilities = Array[ExtResource("2_ability")]([ExtResource("a0"), ExtResource("a1")])
build_on_blueprint_only = true
guide_unit = 1
guide_abilities = Array[ExtResource("2_ability")]([ExtResource("a0"), ExtResource("a1")])
arrows_on_blueprint = true
