[gd_resource type="Resource" script_class="TutorialExplainStep" format=3]

[ext_resource type="Script" path="res://Scripts/Game/Tutorial/Steps/TutorialExplainStep.gd" id="1_step"]
[ext_resource type="Script" path="res://Scripts/Game/Tutorial/TutorialPage.gd" id="2_page"]

[sub_resource type="Resource" id="Page_center"]
script = ExtResource("2_page")
text = "Technologies unlock elemental towers - the towers that win matches. Everyone starts with four free ones."
highlight_key = &"research_button"
caption = "Research Center"

[sub_resource type="Resource" id="Page_paths"]
script = ExtResource("2_page")
text = "Each element has a Basic technology and two paths. Basic opens the element; each path opens one branch of its towers, up to 10,000g."

[sub_resource type="Resource" id="Page_ultimate"]
script = ExtResource("2_page")
text = "The 30,000g Ultimate at the top of a branch needs four: its own Basic and path, and one other element's Basic and path. Yours will be the Firelord."

[resource]
script = ExtResource("1_step")
title = "Technology"
delay_seconds = 2.0
pauses_world = true
holds_clock = true
unlocks_research = true
restricts_actions = true
pages = Array[ExtResource("2_page")]([SubResource("Page_center"), SubResource("Page_paths"), SubResource("Page_ultimate")])
