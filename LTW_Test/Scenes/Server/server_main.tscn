[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/Server/ServerMain.gd" id="1_server_main"]
[ext_resource type="Theme" path="res://Resources/UI/menu_theme.tres" id="2_menu_theme"]
[ext_resource type="Script" path="res://Scripts/References.gd" id="3_references"]
[ext_resource type="Resource" path="res://Resources/Config/network_config.tres" id="4_network_config"]
[ext_resource type="Resource" path="res://Resources/Config/menu_config.tres" id="5_menu_config"]
[ext_resource type="Resource" path="res://Resources/Config/boot_config.tres" id="6_boot_config"]
[ext_resource type="Resource" path="res://Resources/Config/game_config.tres" id="7_game_config"]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_log"]

[node name="ServerMain" type="Control" node_paths=PackedStringArray("_title_label", "_status_label", "_log_view")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_menu_theme")
script = ExtResource("1_server_main")
_title_label = NodePath("Margin/Column/Header/TitleLabel")
_status_label = NodePath("Margin/Column/StatusLabel")
_log_view = NodePath("Margin/Column/LogArea/LogMargin/LogView")

[node name="References" type="Node" parent="."]
script = ExtResource("3_references")
_network_config = ExtResource("4_network_config")
_menu_config = ExtResource("5_menu_config")
_boot_config = ExtResource("6_boot_config")
_game_config = ExtResource("7_game_config")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.04, 0.05, 0.07, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Margin/Column/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.44, 0.89, 0.46, 1)
theme_override_font_sizes/font_size = 28
text = "DEDICATED SERVER"

[node name="HeaderSpacer" type="Control" parent="Margin/Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="RoleLabel" type="Label" parent="Margin/Column/Header"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.45, 0.47, 0.54, 1)
theme_override_font_sizes/font_size = 14
text = "no window when exported headless"

[node name="StatusLabel" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)
theme_override_font_sizes/font_size = 16
text = "Starting..."

[node name="LogArea" type="PanelContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="LogMargin" type="MarginContainer" parent="Margin/Column/LogArea"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="LogView" type="RichTextLabel" parent="Margin/Column/LogArea/LogMargin"]
layout_mode = 2
theme_override_colors/default_color = Color(0.7, 0.74, 0.8, 1)
theme_override_font_sizes/normal_font_size = 14
theme_override_styles/normal = SubResource("StyleBoxEmpty_log")
bbcode_enabled = false
scroll_following = true
selection_enabled = true
