[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/Menus/LobbySettingsPanel.gd" id="1_settings"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 14.0
content_margin_top = 10.0
content_margin_right = 14.0
content_margin_bottom = 10.0
bg_color = Color(0.086, 0.094, 0.118, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.18, 0.2, 0.25, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="LobbySettingsPanel" type="PanelContainer" node_paths=PackedStringArray("_lives_spin", "_lives_label", "_gold_spin", "_research_spin", "_income_spin", "_interval_spin", "_ranked_check", "_creeps_option", "_lanes_check", "_tech_option", "_modifier_option", "_defaults_button", "_hint_label")]
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")
script = ExtResource("1_settings")
_lives_spin = NodePath("Column/Columns/Resources/Grid/LivesSpin")
_lives_label = NodePath("Column/Columns/Resources/Grid/LivesLabel")
_gold_spin = NodePath("Column/Columns/Resources/Grid/GoldSpin")
_research_spin = NodePath("Column/Columns/Resources/Grid/ResearchSpin")
_income_spin = NodePath("Column/Columns/Resources/Grid/IncomeSpin")
_interval_spin = NodePath("Column/Columns/Resources/Grid/IntervalSpin")
_ranked_check = NodePath("Column/Columns/Gameplay/RankedCheck")
_creeps_option = NodePath("Column/Columns/Gameplay/CreepsRow/CreepsOption")
_lanes_check = NodePath("Column/Columns/Gameplay/LanesCheck")
_tech_option = NodePath("Column/Columns/Gameplay/TechRow/TechOption")
_modifier_option = NodePath("Column/Columns/Modifier/ModifierOption")
_defaults_button = NodePath("Column/Footer/DefaultsButton")
_hint_label = NodePath("Column/Footer/HintLabel")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Columns" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Resources" type="VBoxContainer" parent="Column/Columns"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="Column/Columns/Resources"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)
theme_override_font_sizes/font_size = 13
text = "RESOURCES"

[node name="Grid" type="GridContainer" parent="Column/Columns/Resources"]
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 2
columns = 2

[node name="LivesLabel" type="Label" parent="Column/Columns/Resources/Grid"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.72, 0.75, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "Lives (auto)"

[node name="LivesSpin" type="SpinBox" parent="Column/Columns/Resources/Grid"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
min_value = 1.0
max_value = 500.0
value = 100.0

[node name="GoldLabel" type="Label" parent="Column/Columns/Resources/Grid"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.72, 0.75, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "Starting gold"

[node name="GoldSpin" type="SpinBox" parent="Column/Columns/Resources/Grid"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
max_value = 10000000.0
step = 10.0

[node name="ResearchLabel" type="Label" parent="Column/Columns/Resources/Grid"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.72, 0.75, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "Research points"

[node name="ResearchSpin" type="SpinBox" parent="Column/Columns/Resources/Grid"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
max_value = 30.0

[node name="IncomeLabel" type="Label" parent="Column/Columns/Resources/Grid"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.72, 0.75, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "Starting income"

[node name="IncomeSpin" type="SpinBox" parent="Column/Columns/Resources/Grid"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
max_value = 1000000.0
step = 5.0

[node name="IntervalLabel" type="Label" parent="Column/Columns/Resources/Grid"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.72, 0.75, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "Income timer"

[node name="IntervalSpin" type="SpinBox" parent="Column/Columns/Resources/Grid"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
min_value = 1.0
max_value = 300.0
value = 10.0
suffix = "s"

[node name="Gameplay" type="VBoxContainer" parent="Column/Columns"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="Column/Columns/Gameplay"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)
theme_override_font_sizes/font_size = 13
text = "GAMEPLAY"

[node name="RankedCheck" type="CheckButton" parent="Column/Columns/Gameplay"]
layout_mode = 2
tooltip_text = "A ranked match is played on the standard rules. Everything but the technology mode is locked."
text = "Ranked"

[node name="CreepsRow" type="HBoxContainer" parent="Column/Columns/Gameplay"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CreepsLabel" type="Label" parent="Column/Columns/Gameplay/CreepsRow"]
custom_minimum_size = Vector2(86, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.72, 0.75, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "Creeps"

[node name="CreepsOption" type="OptionButton" parent="Column/Columns/Gameplay/CreepsRow"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2

[node name="LanesCheck" type="CheckButton" parent="Column/Columns/Gameplay"]
layout_mode = 2
tooltip_text = "Shuffles who plays which lane, so the send order is not the join order."
text = "Random lanes"

[node name="TechRow" type="HBoxContainer" parent="Column/Columns/Gameplay"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TechLabel" type="Label" parent="Column/Columns/Gameplay/TechRow"]
custom_minimum_size = Vector2(86, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.72, 0.75, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "Tech mode"

[node name="TechOption" type="OptionButton" parent="Column/Columns/Gameplay/TechRow"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
tooltip_text = "Pick Tech: spend your free research yourself.
Random: one Ultimate is rolled for everybody.
Draft: everybody picks one of the same three Ultimates before the match starts."

[node name="Modifier" type="VBoxContainer" parent="Column/Columns"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="Column/Columns/Modifier"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)
theme_override_font_sizes/font_size = 13
text = "MODIFIER"

[node name="ModifierOption" type="OptionButton" parent="Column/Columns/Modifier"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
tooltip_text = "Anonymous: players are shown by their colour instead of their name, in the match only."

[node name="Footer" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HintLabel" type="Label" parent="Column/Footer"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.5, 0.53, 0.61, 1)
theme_override_font_sizes/font_size = 13
text = "Only the host can change these."

[node name="FooterSpacer" type="Control" parent="Column/Footer"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="DefaultsButton" type="Button" parent="Column/Footer"]
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
text = "Defaults"
