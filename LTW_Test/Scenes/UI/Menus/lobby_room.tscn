[node name="SlotList" type="VBoxContainer" parent="Margin/Column/SlotArea/SlotMargin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="StatusLabel" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.58, 0.66, 1)
theme_override_font_sizes/font_size = 14
text = "Not connected."

[node name="Footer" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="LeaveButton" type="Button" parent="Margin/Column/Footer"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
text = "Leave Lobby"

[node name="FooterSpacer" type="Control" parent="Margin/Column/Footer"]
layout_mode = 2
size_flags_horizontal = 3
