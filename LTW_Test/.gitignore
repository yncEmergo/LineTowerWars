# Godot 4+ specific ignores
.godot/
/android/

# Python bytecode from Tools/, which is build-time tooling and not part of the game.
__pycache__/

# Benchmark reports written by run_bench.ps1. Generated output, not content:
# a run is only ever compared with another run on the same machine.
Reports/

# Windows shadow copies of a file being overwritten while something held it
# open - "~name~RF<hex>.TMP" next to the original. Godot makes one every time it
# loads the GodotSteam GDExtension and does not always manage to clean it up, so
# they accumulate at four megabytes each.
#
# Two of them were committed before this rule existed, and BEING TRACKED BEATS
# BEING IGNORED - git applies this file only to paths it is not already
# following, so the rule sat here looking correct while the two it was written
# for went on being versioned. They were removed with `git rm --cached` on
# 2026-09-06; adding the pattern was never going to be enough on its own.
~*.TMP

# Where the Godot editor is on THIS machine, remembered by Tools/godot_path.ps1
# after it finds one. Per-machine by definition - the project is built on more
# than one PC and they keep the editor in different places - so it is the one
# piece of build configuration that must never be committed.
Tools/godot_path.local.txt
